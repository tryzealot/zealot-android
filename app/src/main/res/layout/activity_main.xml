<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sample_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:focusableInTouchMode="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/app_name"
      android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/sample_intro"
      android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:labelFor="@id/endpoint"
      android:text="@string/endpoint_label" />

    <EditText
      android:id="@+id/endpoint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:autofillHints="url"
      android:inputType="textUri"
      android:singleLine="true" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:labelFor="@id/channel_key"
      android:text="@string/channel_key_label" />

    <EditText
      android:id="@+id/channel_key"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:importantForAutofill="no"
      android:inputType="textPassword"
      android:singleLine="true" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:labelFor="@id/prompt_locale"
      android:text="@string/prompt_language" />

    <Spinner
      android:id="@+id/prompt_locale"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp" />

    <CheckBox
      android:id="@+id/custom_sheet_colors"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:minHeight="48dp"
      android:text="@string/custom_sheet_colors" />

    <CheckBox
      android:id="@+id/custom_sheet_typeface"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/custom_sheet_typeface" />

    <Button
      android:id="@+id/enable_prompts"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:textAllCaps="false"
      android:text="@string/enable_prompts" />

    <Button
      android:id="@+id/check_update"
      style="?android:attr/borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAllCaps="false"
      android:text="@string/check_update" />

    <TextView
      android:id="@+id/check_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:accessibilityLiveRegion="polite" />

  </LinearLayout>
</ScrollView>
